{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mfe": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "build:mfe": {
      "dependsOn": [
        "^build:mfe"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "cache": false
    }
  }
}