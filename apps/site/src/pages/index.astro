---
import "../styles/global.css";
import { microfrontends } from "../config/microfrontends";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Akbar Pratama Suryamin</title>
  </head>

  <body>
    <main>
      <section class="page page--center">
        <div id="mfe-home" data-url={microfrontends.home.url}></div>
      </section>
    </main>

    <script>
      import { loadMicroFrontend } from "../lib/mfe/loader";

      async function initializeHome() {
        const container = document.querySelector<HTMLElement>("#mfe-home");

        if (!container) {
          throw new Error("[HOST] Home container not found");
        }

        const url = container.dataset.url;

        if (!url) {
          throw new Error("[HOST] Home MFE URL not configured");
        }

        await loadMicroFrontend({
          url,
          container,
        });
      }

      initializeHome().catch((error) => {
        console.error("[HOST] Failed to initialize Home MFE:", error);
      });
    </script>
  </body>
</html>
